# Copy to .env and export with: set -a; source .env; set +a
DNS_MONITOR_INTERFACE=eth0
DNS_MONITOR_BPF=udp port 53 or tcp port 53
DNS_MONITOR_JSONL=out/events.jsonl
DNS_MONITOR_SQLITE=out/dns.db
DNS_MONITOR_HTML=out/report.html
DNS_MONITOR_MARKDOWN=out/report.md
DNS_MONITOR_LOG_LEVEL=INFO
DNS_MONITOR_MIN_SEVERITY=medium
DNS_MONITOR_RATE_THRESHOLD=50
DNS_MONITOR_RATE_WINDOW=60
DNS_MONITOR_ENTROPY_THRESHOLD=3.6
# DNS_MONITOR_WEBHOOK_URL=https://hooks.slack.com/services/XXX
# DNS_MONITOR_WEBHOOK_FORMAT=slack
